{
  "openapi": "3.1.0",
  "info": {
    "title": "Music Theory MCP",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Chat",
        "description": "Answer a message, streaming typed events (see server/agent/events.py).",
        "operationId": "chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A stream of server-sent events.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/TextDelta"
                    },
                    {
                      "$ref": "#/components/schemas/ToolCall"
                    },
                    {
                      "$ref": "#/components/schemas/ToolResult"
                    },
                    {
                      "$ref": "#/components/schemas/ArtifactReady"
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/Done"
                    }
                  ],
                  "type": "string",
                  "title": "Response 200 Chat Api Chat Post",
                  "discriminator": {
                    "propertyName": "type",
                    "mapping": {
                      "text_delta": "#/components/schemas/TextDelta",
                      "tool_call": "#/components/schemas/ToolCall",
                      "tool_result": "#/components/schemas/ToolResult",
                      "artifact": "#/components/schemas/ArtifactReady",
                      "error": "#/components/schemas/Error",
                      "done": "#/components/schemas/Done"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/messages": {
      "get": {
        "summary": "Session Messages",
        "description": "Return the visible text of a saved chat, without tool traffic.",
        "operationId": "session_messages_api_sessions__session_id__messages_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChatMessage"
                  },
                  "title": "Response Session Messages Api Sessions  Session Id  Messages Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/artifacts/{artifact_id}": {
      "get": {
        "summary": "Artifact Musicxml",
        "operationId": "artifact_musicxml_api_artifacts__artifact_id__get",
        "parameters": [
          {
            "name": "artifact_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Artifact Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/artifacts/{artifact_id}/events": {
      "get": {
        "summary": "Artifact Events",
        "operationId": "artifact_events_api_artifacts__artifact_id__events_get",
        "parameters": [
          {
            "name": "artifact_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Artifact Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreEvents"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/artifacts/{artifact_id}/midi": {
      "get": {
        "summary": "Artifact Midi",
        "operationId": "artifact_midi_api_artifacts__artifact_id__midi_get",
        "parameters": [
          {
            "name": "artifact_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Artifact Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArtifactReady": {
        "properties": {
          "type": {
            "type": "string",
            "const": "artifact",
            "title": "Type",
            "default": "artifact"
          },
          "tool_call_id": {
            "type": "string",
            "title": "Tool Call Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "tool_call_id",
          "kind",
          "id"
        ],
        "title": "ArtifactReady",
        "description": "A score is ready for the notation panel to fetch by id."
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "role",
          "text"
        ],
        "title": "ChatMessage",
        "description": "One visible turn of a saved chat."
      },
      "ChatRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Session Id"
          },
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "message"
        ],
        "title": "ChatRequest"
      },
      "Done": {
        "properties": {
          "type": {
            "type": "string",
            "const": "done",
            "title": "Type",
            "default": "done"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "type": "object",
        "required": [
          "usage"
        ],
        "title": "Done",
        "description": "The turn is over."
      },
      "Error": {
        "properties": {
          "type": {
            "type": "string",
            "const": "error",
            "title": "Type",
            "default": "error"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "recoverable": {
            "type": "boolean",
            "title": "Recoverable"
          }
        },
        "type": "object",
        "required": [
          "message",
          "recoverable"
        ],
        "title": "Error",
        "description": "Something went wrong. `recoverable` means the chat can carry on."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ScoreEvents": {
        "properties": {
          "events": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "events"
        ],
        "title": "ScoreEvents",
        "description": "The notes and chords of a score, in order, for playback."
      },
      "TextDelta": {
        "properties": {
          "type": {
            "type": "string",
            "const": "text_delta",
            "title": "Type",
            "default": "text_delta"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TextDelta",
        "description": "A chunk of Claude's reply."
      },
      "ToolCall": {
        "properties": {
          "type": {
            "type": "string",
            "const": "tool_call",
            "title": "Type",
            "default": "tool_call"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "input": {
            "additionalProperties": true,
            "type": "object",
            "title": "Input"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "input"
        ],
        "title": "ToolCall",
        "description": "Claude decided to call a tool, with these inputs."
      },
      "ToolResult": {
        "properties": {
          "type": {
            "type": "string",
            "const": "tool_result",
            "title": "Type",
            "default": "tool_result"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "summary": {
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "summary"
        ],
        "title": "ToolResult",
        "description": "A tool finished. `summary` is the compact result, or the error message on failure."
      },
      "Usage": {
        "properties": {
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens",
            "default": 0
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens",
            "default": 0
          },
          "cache_read_input_tokens": {
            "type": "integer",
            "title": "Cache Read Input Tokens",
            "default": 0
          },
          "cache_creation_input_tokens": {
            "type": "integer",
            "title": "Cache Creation Input Tokens",
            "default": 0
          }
        },
        "type": "object",
        "title": "Usage",
        "description": "Tokens used across every request in the turn."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
