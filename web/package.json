{
  "name": "music-theory-mcp-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "types": "cd .. && uv run python -m server.api.schema > web/openapi.json && cd web && openapi-typescript openapi.json -o src/api-types.ts"
  },
  "dependencies": {
    "opensheetmusicdisplay": "^1.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
